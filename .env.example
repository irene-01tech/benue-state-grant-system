# =====================================================================
# Application
# =====================================================================
NODE_ENV=development
PORT=3000
APP_NAME="Benue Menstrual Grant Portal"
APP_URL=http://localhost:3000

# =====================================================================
# Database (MySQL)
# =====================================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=grant_management_system
DB_CONNECTION_LIMIT=10

# =====================================================================
# Session
# =====================================================================
SESSION_SECRET=change_this_to_a_long_random_string
SESSION_MAX_AGE_MS=31536000000

# =====================================================================
# Security
# =====================================================================
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# =====================================================================
# Nodemailer (Email Service)
# Example uses Gmail SMTP - use an App Password, not your real password
# =====================================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=grantadmin.irene@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM_NAME="Benue Menstrual Grant Portal"
MAIL_FROM_ADDRESS=grantadmin.irene@gmail.com

# =====================================================================
# First Super Admin (used only by `npm run seed`)
# =====================================================================
SEED_ADMIN_NAME="Irene Anigo"
SEED_ADMIN_EMAIL=grantadmin.irene@gmail.com
SEED_ADMIN_PHONE=09125181985
SEED_ADMIN_PASSWORD=12345678910

# Password for the pre-approved demo accounts (ngo.demo@gmail.com,
# private.demo@gmail.com, school.demo@gmail.com) created by `npm run seed`.
SEED_DEMO_PASSWORD=Demo12345

# =====================================================================
# File Uploads
# =====================================================================
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=uploads
