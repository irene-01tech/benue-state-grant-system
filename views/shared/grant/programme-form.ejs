<%
var isEdit = !!programme;
var selectedLgas = isEdit && programme.target_lgas !== 'ALL' ? programme.target_lgas.split(',') : [];
%>
<div class="page-header">
  <a href="<%= basePath %>/programmes<%= isEdit ? '/' + programme.programme_id : '' %>" class="text-muted" style="display:inline-flex;align-items:center;gap:6px;font-size:0.82rem;margin-bottom:10px;">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
    Back to <%= isEdit ? 'programme' : 'programmes' %>
  </a>
  <h1><%= isEdit ? 'Edit Programme' : 'New Grant Programme' %></h1>
  <p class="text-muted">Programmes go live as <strong>active</strong> immediately, open for school applications.</p>
</div>

<div class="card" style="max-width:720px;">
  <div class="card-body">
    <% if (!categories.length) { %>
      <div class="empty-state" style="padding:20px 10px;">
        <div class="icon-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v4M12 17h.01"/><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
        </div>
        <h3>No grant categories yet</h3>
        <p>The Super Administrator needs to create at least one grant category before you can create a programme.</p>
      </div>
    <% } else { %>
    <form action="<%= isEdit ? basePath + '/programmes/' + programme.programme_id : basePath + '/programmes' %>" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="title">Programme title *</label>
          <input class="form-control" type="text" id="title" name="title" value="<%= isEdit ? programme.title : '' %>" placeholder="e.g. Dignity Kits for Makurdi Schools" required>
        </div>
        <div class="form-group">
          <label class="form-label" for="categoryId">Category *</label>
          <select class="form-control" id="categoryId" name="categoryId" required>
            <option value="" disabled <%= !isEdit ? 'selected' : '' %>>Select category</option>
            <% categories.forEach(function(c) { %>
              <option value="<%= c.category_id %>" <%= isEdit && programme.category_id === c.category_id ? 'selected' : '' %>><%= c.category_name %></option>
            <% }); %>
          </select>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="description">Description</label>
        <textarea class="form-control" id="description" name="description" rows="4" placeholder="What is this programme funding, and who is it for?"><%= isEdit ? (programme.description || '') : '' %></textarea>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="totalBudget">Total budget (₦)</label>
          <input class="form-control" type="number" min="0" step="1000" id="totalBudget" name="totalBudget" value="<%= isEdit ? programme.total_budget : 0 %>">
        </div>
        <div class="form-group">
          <label class="form-label">Target LGAs</label>
          <p class="form-hint" style="margin:0 0 6px;">Leave all unchecked to open this programme to every LGA.</p>
        </div>
      </div>

      <div class="form-group">
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:8px;max-height:180px;overflow-y:auto;border:1px solid var(--color-border);border-radius:var(--radius-md);padding:12px;">
          <% lgas.forEach(function(l) { %>
            <label class="checkbox-row" style="font-size:0.82rem;">
              <input type="checkbox" name="targetLgas" value="<%= l %>" <%= selectedLgas.indexOf(l) > -1 ? 'checked' : '' %>>
              <%= l %>
            </label>
          <% }); %>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="startDate">Start date</label>
          <input class="form-control" type="date" id="startDate" name="startDate" value="<%= isEdit && programme.start_date ? new Date(programme.start_date).toISOString().slice(0,10) : '' %>">
        </div>
        <div class="form-group">
          <label class="form-label" for="endDate">End date</label>
          <input class="form-control" type="date" id="endDate" name="endDate" value="<%= isEdit && programme.end_date ? new Date(programme.end_date).toISOString().slice(0,10) : '' %>">
        </div>
      </div>

      <button type="submit" class="btn btn-primary">
        <%= isEdit ? 'Save changes' : 'Create programme' %>
      </button>
    </form>
    <% } %>
  </div>
</div>
