<%
var evidenceStatusBadge = { pending: 'badge-warning', approved: 'badge-success', rejected: 'badge-danger', reupload_requested: 'badge-warning' };
function fmtDate(d) { return new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }); }
%>
<div class="page-header">
  <h1>Evidence Review</h1>
  <p class="text-muted">Every distribution evidence file submitted across your programmes. Approve or reject from the application page.</p>
</div>

<div class="toolbar">
  <div class="toolbar-filters" style="gap:6px;">
    <a href="<%= basePath %>/evidence?status=pending" class="btn btn-sm <%= statusFilter === 'pending' ? 'btn-primary' : 'btn-outline' %>">Pending</a>
    <a href="<%= basePath %>/evidence?status=approved" class="btn btn-sm <%= statusFilter === 'approved' ? 'btn-primary' : 'btn-outline' %>">Approved</a>
    <a href="<%= basePath %>/evidence?status=rejected" class="btn btn-sm <%= statusFilter === 'rejected' ? 'btn-primary' : 'btn-outline' %>">Rejected</a>
    <a href="<%= basePath %>/evidence?status=reupload_requested" class="btn btn-sm <%= statusFilter === 'reupload_requested' ? 'btn-primary' : 'btn-outline' %>">Re-upload requested</a>
  </div>
</div>

<div class="card">
  <div class="card-body" style="padding:0;">
    <% if (evidence.length) { %>
      <div class="table-wrap">
        <table class="data-table">
          <thead><tr><th>File</th><th>School</th><th>Distribution date</th><th>Uploaded</th><th>Status</th><th></th></tr></thead>
          <tbody>
            <% evidence.forEach(function(ev) { %>
              <tr>
                <td class="cell-primary"><%= ev.file_name %><% if (ev.description) { %><br><span class="cell-muted"><%= ev.description %></span><% } %></td>
                <td><%= ev.school_name %></td>
                <td class="cell-muted"><%= fmtDate(ev.distribution_date) %></td>
                <td class="cell-muted"><%= fmtDate(ev.created_at) %></td>
                <td><span class="badge <%= evidenceStatusBadge[ev.verification_status] %>"><%= ev.verification_status.replace('_',' ') %></span></td>
                <td><a href="<%= basePath %>/applications/<%= ev.linked_application_id %>" class="btn btn-outline btn-sm">Open application</a></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <%- include('../../partials/empty-state', { message: 'No evidence with this status right now.' }) %>
    <% } %>
  </div>
</div>
