<div class="page-header">
  <h1>Settings</h1>
  <p class="text-muted"><%= roleLabel %> organisation profile and reach estimate.</p>
</div>

<div style="display:flex;flex-direction:column;gap:20px;max-width:560px;">
  <div class="card">
    <div class="card-header"><h3>Organisation profile</h3></div>
    <div class="card-body">
      <div class="d-flex justify-between" style="font-size:0.85rem;padding:6px 0;">
        <span class="text-muted">Name</span><span><%= org.org_name %></span>
      </div>
      <% if (ownerType === 'ngo_govt') { %>
        <div class="d-flex justify-between" style="font-size:0.85rem;padding:6px 0;border-top:1px solid var(--color-border);">
          <span class="text-muted">Focus area</span><span><%= org.focus_area || '—' %></span>
        </div>
        <div class="d-flex justify-between" style="font-size:0.85rem;padding:6px 0;border-top:1px solid var(--color-border);">
          <span class="text-muted">Registration number</span><span><%= org.registration_number || '—' %></span>
        </div>
      <% } else { %>
        <div class="d-flex justify-between" style="font-size:0.85rem;padding:6px 0;border-top:1px solid var(--color-border);">
          <span class="text-muted">Description</span><span><%= org.description || '—' %></span>
        </div>
      <% } %>
      <div class="d-flex justify-between" style="font-size:0.85rem;padding:6px 0;border-top:1px solid var(--color-border);">
        <span class="text-muted">Address</span><span><%= org.address || '—' %></span>
      </div>
      <p class="form-hint" style="margin-top:12px;">To update these details, contact the Super Administrator.</p>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h3>Reach estimate</h3></div>
    <div class="card-body">
      <p class="text-muted" style="font-size:0.85rem;margin-bottom:16px;">
        This is your own estimate of how many people or students you expect to reach or support. It's shown on your
        dashboard and in reports — it's purely informational and never blocks anything you do, even if you go over it.
      </p>
      <div class="d-flex justify-between" style="font-size:0.85rem;padding:10px 0;border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border);margin-bottom:16px;">
        <span class="text-muted">Actual reach so far</span><span style="font-weight:600;"><%= currentReach.toLocaleString() %></span>
      </div>
      <form action="<%= basePath %>/settings/reach-estimate" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label class="form-label" for="reachEstimate">Stated reach estimate</label>
          <input class="form-control" type="number" min="1" id="reachEstimate" name="reachEstimate" value="<%= org.reach_estimate %>" required>
          <p class="form-hint"><%= ownerType === 'ngo_govt' ? 'NGO / Government accounts default to up to 7,000,000.' : 'Private Organisation accounts default to up to 4,000.' %></p>
        </div>
        <button type="submit" class="btn btn-primary">Save estimate</button>
      </form>
    </div>
  </div>
</div>
