<%
function fmtMoney(n) { return '₦' + Number(n || 0).toLocaleString(); }
var budgetPct = stats.totalBudget > 0 ? Math.min(Math.round((stats.budgetUtilized / stats.totalBudget) * 100), 100) : 0;
var reachPct = reachEstimate > 0 ? Math.min(Math.round((currentReach / reachEstimate) * 100), 100) : 0;
%>
<div class="page-header">
  <h1>Welcome, <%= org.org_name %></h1>
  <p class="text-muted"><%= roleLabel %> · here's where your programmes and applications stand today.</p>
</div>

<% if (reachExceeded) { %>
  <div class="card" style="border-left:4px solid var(--color-info);margin-bottom:20px;">
    <div class="card-body" style="display:flex;gap:14px;align-items:flex-start;">
      <span class="stat-icon bg-info" style="flex-shrink:0;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
      </span>
      <div>
        <h3 style="font-size:0.95rem;margin-bottom:4px;">You've reached <%= currentReach.toLocaleString() %> people — above your stated estimate of <%= reachEstimate.toLocaleString() %></h3>
        <p class="text-muted" style="font-size:0.85rem;">This is just informational — it doesn't limit anything you do. You can update your stated estimate any time in <a href="<%= basePath %>/settings">Settings</a>.</p>
      </div>
    </div>
  </div>
<% } %>

<div class="stat-grid">
  <div class="card stat-card">
    <span class="stat-icon bg-primary">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/></svg>
    </span>
    <div>
      <div class="stat-value"><%= stats.totalProgrammes %></div>
      <div class="stat-label">Grant programmes (<%= stats.activeProgrammes %> active)</div>
    </div>
  </div>
  <div class="card stat-card">
    <span class="stat-icon bg-warning">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
    </span>
    <div>
      <div class="stat-value"><%= stats.pendingApplications %></div>
      <div class="stat-label">Pending applications</div>
    </div>
  </div>
  <div class="card stat-card">
    <span class="stat-icon bg-success">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
    </span>
    <div>
      <div class="stat-value"><%= stats.approvedApplications %></div>
      <div class="stat-label">Approved applications</div>
    </div>
  </div>
  <div class="card stat-card">
    <span class="stat-icon bg-accent">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="4" width="12" height="17" rx="2"/><path d="M9 11h6M9 15h6"/></svg>
    </span>
    <div>
      <div class="stat-value"><%= stats.pendingSurveys %></div>
      <div class="stat-label">Needs assessments to review</div>
    </div>
  </div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:start;" class="dashboard-grid">
  <div class="card">
    <div class="card-header"><h3>Budget utilisation</h3></div>
    <div class="card-body">
      <div class="d-flex justify-between align-center" style="margin-bottom:10px;">
        <span class="text-muted" style="font-size:0.85rem;"><%= fmtMoney(stats.budgetUtilized) %> used</span>
        <span class="text-muted" style="font-size:0.85rem;"><%= fmtMoney(stats.totalBudget) %> total</span>
      </div>
      <div class="progress-bar-track"><div class="progress-bar-fill" style="width:<%= budgetPct %>%;"></div></div>
      <p class="cell-muted" style="margin-top:10px;"><%= budgetPct %>% utilised across all programmes</p>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h3>Reach estimate</h3></div>
    <div class="card-body">
      <div class="d-flex justify-between align-center" style="margin-bottom:10px;">
        <span class="text-muted" style="font-size:0.85rem;"><%= currentReach.toLocaleString() %> reached</span>
        <span class="text-muted" style="font-size:0.85rem;">of <%= reachEstimate.toLocaleString() %> estimate</span>
      </div>
      <div class="progress-bar-track"><div class="progress-bar-fill" style="width:<%= reachPct %>%;<%= reachExceeded ? 'background:var(--color-info);' : '' %>"></div></div>
      <p class="cell-muted" style="margin-top:10px;">This is your own stated estimate — it's informational only and never blocks you. <a href="<%= basePath %>/settings">Adjust it</a>.</p>
    </div>
  </div>
</div>

<div class="card" style="margin-top:20px;">
  <div class="card-body" style="display:flex;gap:16px;flex-wrap:wrap;">
    <a href="<%= basePath %>/programmes/new" class="btn btn-primary">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
      New grant programme
    </a>
    <a href="<%= basePath %>/needs-assessments?status=pending" class="btn btn-outline">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="4" width="12" height="17" rx="2"/><path d="M9 11h6M9 15h6"/></svg>
      Review needs assessments
    </a>
    <a href="<%= basePath %>/applications?status=submitted" class="btn btn-outline">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/><path d="M5.45 5.11L2 12v6a2 2 0 002 2h16a2 2 0 002-2v-6l-3.45-6.89A2 2 0 0016.76 4H7.24a2 2 0 00-1.79 1.11z"/></svg>
      Review pending applications
    </a>
    <a href="<%= basePath %>/evidence" class="btn btn-outline">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><polyline points="9 11 12 14 17 9"/></svg>
      Verify evidence
    </a>
    <% if (basePath === '/organisation') { %>
      <a href="<%= basePath %>/approvals" class="btn btn-outline">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/></svg>
        Review registrations
      </a>
    <% } %>
  </div>
</div>

<style>
  @media (max-width: 992px) { .dashboard-grid { grid-template-columns: 1fr !important; } }
</style>
