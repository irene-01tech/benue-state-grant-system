<%
var statusBadge = { draft: 'badge-neutral', active: 'badge-success', closed: 'badge-warning', archived: 'badge-neutral' };
var appStatusBadge = { submitted: 'badge-warning', under_review: 'badge-warning', approved: 'badge-success', rejected: 'badge-danger' };
function fmtDate(d) { if (!d) return '—'; return new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }); }
function fmtMoney(n) { return '₦' + Number(n || 0).toLocaleString(); }
var budgetPct = programme.total_budget > 0 ? Math.min(Math.round((programme.budget_utilized / programme.total_budget) * 100), 100) : 0;
%>
<div class="page-header">
  <a href="<%= basePath %>/programmes" class="text-muted" style="display:inline-flex;align-items:center;gap:6px;font-size:0.82rem;margin-bottom:10px;">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
    Back to programmes
  </a>
  <div class="d-flex justify-between align-center" style="flex-wrap:wrap;gap:12px;">
    <div>
      <h1><%= programme.title %></h1>
      <p class="text-muted"><%= programme.category_name %> · <span class="badge <%= statusBadge[programme.status] %>"><%= programme.status %></span></p>
    </div>
    <div class="d-flex gap-8">
      <a href="<%= basePath %>/programmes/<%= programme.programme_id %>/edit" class="btn btn-outline btn-sm">Edit</a>
      <% if (programme.status === 'active') { %>
        <form action="<%= basePath %>/programmes/<%= programme.programme_id %>/status" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="status" value="closed">
          <button type="submit" class="btn btn-outline btn-sm">Close programme</button>
        </form>
      <% } else if (programme.status === 'draft' || programme.status === 'closed') { %>
        <form action="<%= basePath %>/programmes/<%= programme.programme_id %>/status" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="status" value="active">
          <button type="submit" class="btn btn-primary btn-sm">Activate</button>
        </form>
      <% } %>
    </div>
  </div>
</div>

<div style="display:grid;grid-template-columns:1.4fr 1fr;gap:20px;align-items:start;" class="dashboard-grid">
  <div class="card">
    <div class="card-header"><h3>About this programme</h3></div>
    <div class="card-body">
      <p class="text-muted" style="margin-bottom:16px;"><%= programme.description || 'No description provided.' %></p>
      <div class="d-flex justify-between" style="font-size:0.85rem;padding:6px 0;border-top:1px solid var(--color-border);">
        <span class="text-muted">Window</span><span><%= fmtDate(programme.start_date) %> – <%= fmtDate(programme.end_date) %></span>
      </div>
      <div class="d-flex justify-between" style="font-size:0.85rem;padding:6px 0;border-top:1px solid var(--color-border);">
        <span class="text-muted">Target LGAs</span><span><%= programme.target_lgas === 'ALL' ? 'All LGAs' : programme.target_lgas %></span>
      </div>
      <div class="d-flex justify-between" style="font-size:0.85rem;padding:6px 0;border-top:1px solid var(--color-border);">
        <span class="text-muted">Created</span><span><%= fmtDate(programme.created_at) %></span>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h3>Budget</h3></div>
    <div class="card-body">
      <div class="d-flex justify-between align-center" style="margin-bottom:10px;">
        <span class="text-muted" style="font-size:0.85rem;"><%= fmtMoney(programme.budget_utilized) %> used</span>
        <span class="text-muted" style="font-size:0.85rem;"><%= fmtMoney(programme.total_budget) %> total</span>
      </div>
      <div class="progress-bar-track"><div class="progress-bar-fill" style="width:<%= budgetPct %>%;"></div></div>
      <p class="cell-muted" style="margin-top:10px;"><%= budgetPct %>% utilised</p>
    </div>
  </div>
</div>

<div class="card" style="margin-top:20px;">
  <div class="card-header"><h3>Applications (<%= applications.length %>)</h3></div>
  <div class="card-body" style="padding:0;">
    <% if (applications.length) { %>
      <div class="table-wrap">
        <table class="data-table">
          <thead><tr><th>School</th><th>LGA</th><th>Beneficiaries</th><th>Submitted</th><th>Status</th><th></th></tr></thead>
          <tbody>
            <% applications.forEach(function(a) { %>
              <tr>
                <td class="cell-primary"><%= a.school_name %></td>
                <td><%= a.lga %></td>
                <td><%= a.number_of_beneficiaries %></td>
                <td class="cell-muted"><%= fmtDate(a.created_at) %></td>
                <td><span class="badge <%= appStatusBadge[a.status] %>"><%= a.status.replace('_', ' ') %></span></td>
                <td><a href="<%= basePath %>/applications/<%= a.application_id %>" class="btn btn-outline btn-sm">Review</a></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <%- include('../../partials/empty-state', { message: 'No schools have applied to this programme yet.' }) %>
    <% } %>
  </div>
</div>

<style>
  @media (max-width: 992px) { .dashboard-grid { grid-template-columns: 1fr !important; } }
</style>
