<%
function fmtDate(d) { if (!d) return '—'; return new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }); }
var statusBadge = { pending: 'badge-warning', approved: 'badge-success', rejected: 'badge-danger' };
%>
<div class="page-header">
  <a href="<%= basePath %>/needs-assessments" class="text-muted" style="display:inline-flex;align-items:center;gap:6px;font-size:0.82rem;margin-bottom:10px;">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
    Back to needs assessments
  </a>
  <h1><%= survey.school_name %></h1>
  <p class="text-muted"><span class="badge <%= statusBadge[survey.status] %>"><%= survey.status %></span></p>
</div>

<div style="display:flex;flex-direction:column;gap:20px;max-width:720px;">
  <div class="card">
    <div class="card-header"><h3>Assessment details</h3></div>
    <div class="card-body">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px;">
        <div class="d-flex justify-between" style="font-size:0.84rem;"><span class="text-muted">Girls needing support</span><span><%= survey.girls_needing_support %></span></div>
        <div class="d-flex justify-between" style="font-size:0.84rem;"><span class="text-muted">Female students</span><span><%= survey.total_female_students %></span></div>
        <div class="d-flex justify-between" style="font-size:0.84rem;"><span class="text-muted">Toilet facilities</span><span style="text-transform:capitalize;"><%= survey.existing_toilet_facilities %></span></div>
        <div class="d-flex justify-between" style="font-size:0.84rem;"><span class="text-muted">Water availability</span><span style="text-transform:capitalize;"><%= survey.water_availability %></span></div>
        <div class="d-flex justify-between" style="font-size:0.84rem;"><span class="text-muted">Menstrual education programme</span><span><%= survey.menstrual_education_programme ? 'Yes' : 'No' %></span></div>
        <div class="d-flex justify-between" style="font-size:0.84rem;"><span class="text-muted">Submitted</span><span><%= fmtDate(survey.created_at) %></span></div>
      </div>
      <div style="padding-top:8px;border-top:1px solid var(--color-border);">
        <div class="d-flex justify-between" style="font-size:0.84rem;padding:4px 0;"><span class="text-muted">Estimated pad requirement</span><span><%= survey.estimated_pad_requirement %></span></div>
        <div class="d-flex justify-between" style="font-size:0.84rem;padding:4px 0;"><span class="text-muted">Hygiene kit requirement</span><span><%= survey.hygiene_kit_requirement %></span></div>
      </div>
      <% if (survey.previous_interventions) { %><p class="cell-muted" style="margin-top:10px;">Previous interventions: <%= survey.previous_interventions %></p><% } %>
      <% if (survey.other_challenges) { %><p class="cell-muted" style="margin-top:6px;">Other challenges: <%= survey.other_challenges %></p><% } %>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h3>School representative</h3></div>
    <div class="card-body">
      <p style="font-weight:600;font-size:0.9rem;margin-bottom:2px;"><%= survey.school_rep_name %></p>
      <p class="text-muted" style="font-size:0.84rem;"><%= survey.school_rep_email %></p>
    </div>
  </div>

  <% if (survey.status === 'pending') { %>
    <div class="card">
      <div class="card-header"><h3>Review decision</h3></div>
      <div class="card-body">
        <form action="<%= basePath %>/needs-assessments/<%= survey.survey_id %>/decide" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-group">
            <label class="form-label" for="comment">Comment <span class="optional">(shown to the school)</span></label>
            <textarea class="form-control" id="comment" name="comment" rows="3" placeholder="Optional note about your decision"></textarea>
          </div>
          <div class="d-flex gap-8">
            <button type="submit" name="decision" value="approved" class="btn btn-success">Approve</button>
            <button type="submit" name="decision" value="rejected" class="btn btn-danger">Reject</button>
          </div>
        </form>
      </div>
    </div>
  <% } else { %>
    <div class="card">
      <div class="card-body" style="display:flex;gap:14px;align-items:flex-start;">
        <span class="stat-icon <%= survey.status === 'approved' ? 'bg-success' : 'bg-danger' %>" style="flex-shrink:0;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
        </span>
        <div>
          <h3 style="font-size:0.95rem;margin-bottom:4px;">Assessment <%= survey.status %></h3>
          <p class="text-muted" style="font-size:0.85rem;">Reviewed <%= fmtDate(survey.reviewed_at) %><% if (survey.review_comment) { %> — "<%= survey.review_comment %>"<% } %></p>
        </div>
      </div>
    </div>
  <% } %>
</div>
