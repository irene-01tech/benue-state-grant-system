<%
function fmtDate(d) { if (!d) return '—'; var dt = new Date(d); return dt.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }); }
var statusBadge = { active: 'badge-success', pending: 'badge-warning', suspended: 'badge-danger', rejected: 'badge-neutral' };
%>
<div class="page-header">
  <h1>User Management</h1>
  <p class="text-muted">Every account on the platform, across every role.</p>
</div>

<div class="toolbar">
  <div class="toolbar-filters">
    <div class="search-box">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
      <input type="text" class="form-control" id="searchInput" placeholder="Search name or email…" value="<%= filters.search %>">
    </div>
    <select class="form-control filter-select" id="roleFilter">
      <option value="">All roles</option>
      <option value="super_admin" <%= filters.role === 'super_admin' ? 'selected' : '' %>>Super Admin</option>
      <option value="ngo_govt" <%= filters.role === 'ngo_govt' ? 'selected' : '' %>>NGO / Government</option>
      <option value="private_org" <%= filters.role === 'private_org' ? 'selected' : '' %>>Private Organisation</option>
      <option value="school_representative" <%= filters.role === 'school_representative' ? 'selected' : '' %>>School Representative</option>
    </select>
    <select class="form-control filter-select" id="statusFilterSel">
      <option value="">All statuses</option>
      <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
      <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pending</option>
      <option value="suspended" <%= filters.status === 'suspended' ? 'selected' : '' %>>Suspended</option>
      <option value="rejected" <%= filters.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
    </select>
  </div>
  <span class="text-muted" style="font-size:0.82rem;"><%= users.length %> user<%= users.length === 1 ? '' : 's' %></span>
</div>

<div class="card">
  <div class="card-body" style="padding:0;">
    <% if (users.length) { %>
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Last login</th><th>Joined</th><th></th></tr>
          </thead>
          <tbody>
            <% users.forEach(function(u) { %>
              <tr>
                <td class="cell-primary"><%= u.full_name %></td>
                <td><%= u.email %></td>
                <td><span class="badge badge-neutral"><%= u.role_name.replace(/_/g, ' ') %></span></td>
                <td><span class="badge <%= statusBadge[u.status] || 'badge-neutral' %>"><%= u.status %></span></td>
                <td class="cell-muted"><%= u.last_login ? fmtDate(u.last_login) : 'Never' %></td>
                <td class="cell-muted"><%= fmtDate(u.created_at) %></td>
                <td>
                  <div class="d-flex gap-8">
                    <form action="/super_admin/users/<%= u.user_id %>/reset-password" method="POST" class="js-plain-form">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="button" class="btn btn-outline btn-sm js-confirm-btn"
                        data-title="Reset password for <%= u.full_name %>?"
                        data-text="A new temporary password will be emailed to <%= u.email %>."
                        data-confirm="Reset password">Reset password</button>
                    </form>
                    <% if (u.status === 'suspended') { %>
                      <form action="/super_admin/users/<%= u.user_id %>/activate" method="POST" class="js-plain-form">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="button" class="btn btn-success btn-sm js-confirm-btn"
                          data-title="Reactivate <%= u.full_name %>?"
                          data-text="They will regain access to their dashboard immediately."
                          data-confirm="Reactivate">Reactivate</button>
                      </form>
                    <% } else if (u.status === 'active') { %>
                      <form action="/super_admin/users/<%= u.user_id %>/suspend" method="POST" class="js-plain-form">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="button" class="btn btn-danger btn-sm js-confirm-btn"
                          data-title="Suspend <%= u.full_name %>?"
                          data-text="They will immediately lose access until reactivated."
                          data-confirm="Suspend">Suspend</button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <%- include('../partials/empty-state', { message: 'No users match these filters.' }) %>
    <% } %>
  </div>
</div>

<script>
  function applyFilters() {
    var params = new URLSearchParams();
    var role = document.getElementById('roleFilter').value;
    var status = document.getElementById('statusFilterSel').value;
    var search = document.getElementById('searchInput').value;
    if (role) params.set('role', role);
    if (status) params.set('status', status);
    if (search) params.set('search', search);
    window.location.href = '/super_admin/users?' + params.toString();
  }
  document.getElementById('roleFilter').addEventListener('change', applyFilters);
  document.getElementById('statusFilterSel').addEventListener('change', applyFilters);
  document.getElementById('searchInput').addEventListener('keydown', function (e) {
    if (e.key === 'Enter') applyFilters();
  });

  document.addEventListener('click', function (e) {
    var btn = e.target.closest('.js-confirm-btn');
    if (!btn) return;
    var form = btn.closest('form');
    confirmAction(form, {
      title: btn.dataset.title,
      text: btn.dataset.text,
      confirmText: btn.dataset.confirm,
      icon: 'warning',
      danger: btn.classList.contains('btn-danger'),
    });
  });
</script>
