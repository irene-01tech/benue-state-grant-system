<div class="page-header">
  <h1>System Settings</h1>
  <p class="text-muted">Global configuration used across the platform.</p>
</div>

<div class="card" style="max-width:640px;">
  <div class="card-header"><h3>General configuration</h3></div>
  <div class="card-body">
    <form action="/super_admin/settings" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <% fields.forEach(function(f) { %>
        <div class="form-group">
          <label class="form-label" for="<%= f.key %>"><%= f.label %></label>
          <input class="form-control" type="<%= f.type %>" id="<%= f.key %>" name="<%= f.key %>" value="<%= f.value %>"
            <% if (f.type === 'number') { %>min="1"<% } %>>
        </div>
      <% }); %>

      <button type="submit" class="btn btn-primary">Save settings</button>
    </form>
  </div>
</div>

<div class="card" style="max-width:640px;margin-top:20px;">
  <div class="card-body" style="display:flex; gap:14px; align-items:flex-start;">
    <span class="stat-icon bg-warning" style="flex-shrink:0;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v4M12 17h.01"/><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
    </span>
    <div>
      <h3 style="font-size:0.95rem;margin-bottom:6px;">Applying changes</h3>
      <p class="text-muted" style="font-size:0.85rem;">
        Session timeout and upload limit changes take effect for new sessions and uploads going forward —
        they don't interrupt anyone currently signed in or mid-upload.
      </p>
    </div>
  </div>
</div>
