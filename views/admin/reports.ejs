<div class="page-header">
  <h1>Reports</h1>
  <p class="text-muted">Generate and export system reports as CSV, Excel, or PDF.</p>
</div>

<div class="stat-grid">
  <% reportMeta.forEach(function(r) { %>
    <div class="card" style="padding:22px;">
      <div class="d-flex justify-between align-center" style="margin-bottom:10px;">
        <h3 style="font-size:1rem;margin:0;"><%= r.label %></h3>
        <span class="badge badge-neutral"><%= r.total %> records</span>
      </div>
      <p class="text-muted" style="font-size:0.85rem;margin-bottom:18px;"><%= r.description %></p>
      <div class="d-flex gap-8" style="flex-wrap:wrap;">
        <a class="btn btn-outline btn-sm" href="/super_admin/reports/export/<%= r.key %>/csv">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          CSV
        </a>
        <a class="btn btn-outline btn-sm" href="/super_admin/reports/export/<%= r.key %>/excel">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Excel
        </a>
        <a class="btn btn-outline btn-sm" href="/super_admin/reports/export/<%= r.key %>/pdf">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          PDF
        </a>
      </div>
    </div>
  <% }); %>
</div>

<div class="card">
  <div class="card-body" style="display:flex; gap:14px; align-items:flex-start;">
    <span class="stat-icon bg-info" style="flex-shrink:0;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
    </span>
    <div>
      <h3 style="font-size:0.95rem;margin-bottom:6px;">About these reports</h3>
      <p class="text-muted" style="font-size:0.85rem;">
        Each export reflects live data at the moment you download it. Organisation reports include every record
        regardless of approval status; the audit trail report covers the full history recorded on the system.
        Every export is itself logged to the audit trail.
      </p>
    </div>
  </div>
</div>
