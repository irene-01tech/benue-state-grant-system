<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/auth-head') %>
</head>
<body>
  <%- include('../partials/flash-toast') %>

  <div class="auth-shell">
    <aside class="auth-visual">
      <div class="auth-visual-brand">
        <span class="logo-mark">BG</span>
        <span><%= appName %></span>
      </div>

      <div class="auth-visual-content">
        <h2>Three partners, one shared record of dignity delivered.</h2>
        <p>Whichever kind of organisation you represent, registration is reviewed by the Super Administrator before you get access — so every account on the platform is verified.</p>
      </div>

      <div class="auth-stats">
        <div class="item"><strong>1–2</strong><span>working days for review</span></div>
        <div class="item"><strong>Free</strong><span>to register</span></div>
      </div>
    </aside>

    <section class="auth-form-side">
      <div class="auth-form-card" style="max-width:460px;">
        <div class="mobile-brand">
          <span class="logo-mark">BG</span>
          <span style="font-family:var(--font-heading);font-weight:600;"><%= appName %></span>
        </div>

        <h1>Register your organisation</h1>
        <p class="subtitle">Choose the option that best describes you.</p>

        <div class="role-choice-grid">
          <a href="/auth/register/school" class="role-choice-card">
            <span class="icon-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10L12 4 2 10l10 6 10-6z"/><path d="M6 12v5c0 1.5 3 3 6 3s6-1.5 6-3v-5"/></svg>
            </span>
            <span>
              <h4>Secondary School</h4>
              <p>Apply for grants, run needs assessments, and record distribution to students.</p>
            </span>
            <span class="arrow">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
            </span>
          </a>

          <a href="/auth/register/organisation" class="role-choice-card">
            <span class="icon-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.8 4.6a5.5 5.5 0 00-7.8 0L12 5.6l-1-1a5.5 5.5 0 10-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 000-7.8z"/></svg>
            </span>
            <span>
              <h4>NGO / Government Organisation</h4>
              <p>Create grant programmes, review needs assessments and applications, and allocate resources to schools.</p>
            </span>
            <span class="arrow">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
            </span>
          </a>

          <a href="/auth/register/private-org" class="role-choice-card">
            <span class="icon-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M5 21V9l7-5 7 5v12M9 21v-6h6v6"/></svg>
            </span>
            <span>
              <h4>Private Organisation / Individual</h4>
              <p>Fund and manage smaller-scale grant programmes and support schools directly.</p>
            </span>
            <span class="arrow">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
            </span>
          </a>
        </div>

        <p class="auth-footer-link">Already have an account? <a href="/auth/login">Sign in</a></p>
      </div>
    </section>
  </div>

  <script src="/js/auth.js"></script>
</body>
</html>
