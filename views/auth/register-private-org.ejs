<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/auth-head') %>
</head>
<body>
  <%- include('../partials/flash-toast') %>

  <div class="auth-shell">
    <aside class="auth-visual">
      <div class="auth-visual-brand">
        <span class="logo-mark">BG</span>
        <span><%= appName %></span>
      </div>

      <div class="auth-visual-content">
        <h2>Register as a private organisation or individual.</h2>
        <p>Fund and manage smaller-scale grant programmes with the same transparent workflow used across the platform — needs assessments, applications, resource allocation, and evidence verification.</p>
      </div>

      <div class="auth-stats">
        <div class="item"><strong>Step 1</strong><span>Register &amp; wait for approval</span></div>
        <div class="item"><strong>Step 2</strong><span>Create a grant programme</span></div>
        <div class="item"><strong>Step 3</strong><span>Support schools directly</span></div>
      </div>
    </aside>

    <section class="auth-form-side">
      <div class="auth-form-card" style="max-width:500px;">
        <div class="mobile-brand">
          <span class="logo-mark">BG</span>
          <span style="font-family:var(--font-heading);font-weight:600;"><%= appName %></span>
        </div>

        <a href="/auth/register" class="text-muted" style="display:inline-flex;align-items:center;gap:6px;font-size:0.82rem;margin-bottom:14px;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
          Back to registration options
        </a>

        <h1>Private Organisation registration</h1>
        <p class="subtitle">For individuals, businesses, or informal groups supporting schools directly. Fields marked with an asterisk are required.</p>

        <form action="/auth/register/private-org" method="POST" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <h4 style="margin:18px 0 12px;font-size:0.8rem;text-transform:uppercase;letter-spacing:0.04em;color:var(--color-text-muted);">Contact person</h4>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="fullName">Full name *</label>
              <input class="form-control" type="text" id="fullName" name="fullName" placeholder="e.g. Grace Terhemba" required>
            </div>
            <div class="form-group">
              <label class="form-label" for="phone">Phone number *</label>
              <input class="form-control" type="tel" id="phone" name="phone" placeholder="080..." required>
            </div>
          </div>
          <div class="form-group">
            <label class="form-label" for="email">Email address *</label>
            <input class="form-control" type="email" id="email" name="email" placeholder="you@example.com" required>
            <p class="form-hint">Your login and temporary password will be sent to this address once approved.</p>
          </div>

          <h4 style="margin:22px 0 12px;font-size:0.8rem;text-transform:uppercase;letter-spacing:0.04em;color:var(--color-text-muted);">Organisation details</h4>
          <div class="form-group">
            <label class="form-label" for="orgName">Organisation / individual name *</label>
            <input class="form-control" type="text" id="orgName" name="orgName" placeholder="e.g. Grace Terhemba Foundation, or your own name" required>
          </div>
          <div class="form-group">
            <label class="form-label" for="description">Description <span class="optional">(optional)</span></label>
            <textarea class="form-control" id="description" name="description" rows="3" placeholder="What kind of support are you looking to give?"></textarea>
          </div>
          <div class="form-group">
            <label class="form-label" for="address">Address *</label>
            <input class="form-control" type="text" id="address" name="address" placeholder="Where you're based" required>
          </div>
          <div class="form-group">
            <label class="form-label" for="website">Website <span class="optional">(optional)</span></label>
            <input class="form-control" type="url" id="website" name="website" placeholder="https://">
          </div>

          <button type="submit" class="btn btn-primary btn-block" style="margin-top:6px;">Submit registration</button>
        </form>

        <p class="auth-footer-link">Already have an account? <a href="/auth/login">Sign in</a></p>
      </div>
    </section>
  </div>

  <script src="/js/auth.js"></script>
</body>
</html>
