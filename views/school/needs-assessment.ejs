<%
function fmtDate(d) { return new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }); }
var statusBadge = { pending: 'badge-warning', approved: 'badge-success', rejected: 'badge-danger' };
var hasOrgs = (organisations && organisations.length) || (privateOrgs && privateOrgs.length);
%>
<div class="page-header">
  <h1>Needs Assessment</h1>
  <p class="text-muted">Document your school's situation and send it to a specific NGO/Government or Private Organisation before applying — this helps them allocate resources fairly.</p>
</div>

<div style="display:grid;grid-template-columns:1.3fr 1fr;gap:20px;align-items:start;" class="dashboard-grid">
  <div class="card">
    <div class="card-header"><h3>New assessment</h3></div>
    <div class="card-body">
      <% if (!hasOrgs) { %>
        <div class="empty-state" style="padding:20px 10px;">
          <div class="icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v4M12 17h.01"/><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
          </div>
          <h3>No approved organisations yet</h3>
          <p>There are no approved NGO/Government or Private Organisation accounts to send a needs assessment to right now. Check back once one has registered and been approved.</p>
        </div>
      <% } else { %>
        <form action="/school_representative/needs-assessment" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="form-group">
            <label class="form-label" for="targetOrg">Send this assessment to *</label>
            <select class="form-control" id="targetOrg" name="targetOrg" required>
              <option value="" disabled selected>Select an organisation</option>
              <% if (organisations && organisations.length) { %>
                <optgroup label="NGO / Government">
                  <% organisations.forEach(function(o) { %>
                    <option value="ngo_govt:<%= o.organisation_id %>"><%= o.org_name %></option>
                  <% }); %>
                </optgroup>
              <% } %>
              <% if (privateOrgs && privateOrgs.length) { %>
                <optgroup label="Private Organisations">
                  <% privateOrgs.forEach(function(p) { %>
                    <option value="private_org:<%= p.private_org_id %>"><%= p.org_name %></option>
                  <% }); %>
                </optgroup>
              <% } %>
            </select>
            <p class="form-hint">This organisation will review your assessment before you apply for a grant from them.</p>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="totalFemaleStudents">Total female students *</label>
              <input class="form-control" type="number" min="0" id="totalFemaleStudents" name="totalFemaleStudents" required>
            </div>
            <div class="form-group">
              <label class="form-label" for="girlsNeedingSupport">Girls needing support *</label>
              <input class="form-control" type="number" min="0" id="girlsNeedingSupport" name="girlsNeedingSupport" required>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="existingToiletFacilities">Existing toilet facilities</label>
              <select class="form-control" id="existingToiletFacilities" name="existingToiletFacilities">
                <option value="none">None</option>
                <option value="poor" selected>Poor</option>
                <option value="adequate">Adequate</option>
                <option value="good">Good</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label" for="waterAvailability">Water availability</label>
              <select class="form-control" id="waterAvailability" name="waterAvailability">
                <option value="none">None</option>
                <option value="irregular" selected>Irregular</option>
                <option value="regular">Regular</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="checkbox-row">
              <input type="checkbox" name="menstrualEducationProgramme">
              The school currently runs a menstrual health education programme
            </label>
          </div>

          <div class="form-group">
            <label class="form-label" for="previousInterventions">Previous interventions <span class="optional">(optional)</span></label>
            <textarea class="form-control" id="previousInterventions" name="previousInterventions" rows="2" placeholder="Any past support received"></textarea>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="estimatedPadRequirement">Estimated sanitary pad requirement (monthly)</label>
              <input class="form-control" type="number" min="0" id="estimatedPadRequirement" name="estimatedPadRequirement" value="0">
            </div>
            <div class="form-group">
              <label class="form-label" for="hygieneKitRequirement">Hygiene kit requirement</label>
              <input class="form-control" type="number" min="0" id="hygieneKitRequirement" name="hygieneKitRequirement" value="0">
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="otherChallenges">Other challenges <span class="optional">(optional)</span></label>
            <textarea class="form-control" id="otherChallenges" name="otherChallenges" rows="3" placeholder="Anything else this organisation should know"></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-block">Submit assessment</button>
        </form>
      <% } %>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h3>Past submissions</h3></div>
    <div class="card-body" style="padding:0;">
      <% if (surveys.length) { %>
        <div class="table-wrap">
          <table class="data-table">
            <thead><tr><th>Date</th><th>Sent to</th><th>Girls needing support</th><th>Status</th></tr></thead>
            <tbody>
              <% surveys.forEach(function(s) { %>
                <tr>
                  <td class="cell-primary"><%= fmtDate(s.created_at) %></td>
                  <td><%= s.target_org_name || '—' %></td>
                  <td><%= s.girls_needing_support %></td>
                  <td><span class="badge <%= statusBadge[s.status] %>"><%= s.status %></span></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <%- include('../partials/empty-state', { message: 'No assessments submitted yet.' }) %>
      <% } %>
    </div>
  </div>
</div>

<style>
  @media (max-width: 992px) { .dashboard-grid { grid-template-columns: 1fr !important; } }
</style>