<%
var initials = (currentUser.full_name || '?').split(' ').filter(Boolean).slice(0,2).map(function(w){ return w[0]; }).join('').toUpperCase();
var roleLabels = {
  super_admin: 'Super Administrator',
  ngo_govt: 'NGO / Government',
  private_org: 'Private Organisation',
  school_representative: 'School Representative',
};
%>
<header class="topnav">
  <div class="topnav-left">
    <button class="sidebar-toggle" id="sidebarToggle" aria-label="Collapse sidebar">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
    <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Open menu">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
    <nav class="breadcrumbs">
      <a href="/<%= currentUser.role_name %>/dashboard">Home</a>
      <% if (typeof breadcrumb !== 'undefined' && breadcrumb) { %> / <span class="current"><%= breadcrumb %></span>
      <% } else { %> / <span class="current"><%= title %></span> <% } %>
    </nav>
  </div>

  <div class="topnav-right">
    <div class="profile-menu">
      <button class="icon-btn" id="notificationTrigger" aria-label="Notifications">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 10-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
        <% if (unreadNotificationCount > 0) { %><span class="dot"></span><% } %>
      </button>
      <div class="dropdown-menu" id="notificationDropdown" style="width:320px;">
        <div class="d-flex justify-between align-center" style="padding:10px 12px;">
          <div style="font-weight:600;font-size:0.85rem;">Notifications</div>
          <% if (unreadNotificationCount > 0) { %>
            <form action="/account/notifications/read-all" method="POST">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn-link" style="font-size:0.76rem;">Mark all read</button>
            </form>
          <% } %>
        </div>
        <div class="dropdown-divider"></div>
        <% if (notifications.length) { %>
          <% notifications.forEach(function(n) { %>
            <form action="/account/notifications/<%= n.notification_id %>/read" method="POST">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="dropdown-item" style="white-space:normal;align-items:flex-start;text-align:left;<%= n.is_read ? 'opacity:0.6;' : '' %>">
                <span style="width:7px;height:7px;border-radius:50%;background:<%= n.is_read ? 'transparent' : 'var(--color-danger)' %>;margin-top:6px;flex-shrink:0;"></span>
                <span>
                  <span style="display:block;font-weight:600;font-size:0.8rem;"><%= n.title %></span>
                  <span style="display:block;font-size:0.76rem;color:var(--color-text-muted);"><%= n.message %></span>
                </span>
              </button>
            </form>
          <% }); %>
        <% } else { %>
          <div style="padding:24px 12px;text-align:center;color:var(--color-text-muted);font-size:0.82rem;">You're all caught up.</div>
        <% } %>
      </div>
    </div>

    <div class="profile-menu">
      <button class="profile-trigger" id="profileTrigger">
        <span class="avatar"><%= initials %></span>
        <span>
          <span class="name" style="display:block;"><%= currentUser.full_name %></span>
          <span class="role" style="display:block;"><%= roleLabels[currentUser.role_name] || '' %></span>
        </span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
      </button>
      <div class="dropdown-menu" id="profileDropdown">
        <div style="padding:10px 12px;">
          <div style="font-weight:600;font-size:0.85rem;"><%= currentUser.full_name %></div>
          <div style="font-size:0.76rem;color:var(--color-text-muted);"><%= currentUser.email %></div>
        </div>
        <div class="dropdown-divider"></div>
        <a href="/<%= currentUser.role_name %>/dashboard" class="dropdown-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
          Dashboard
        </a>
        <a href="/account/profile" class="dropdown-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          My profile
        </a>
        <a href="/account/profile#currentPassword" class="dropdown-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 018 0v3"/></svg>
          Change password
        </a>
        <div class="dropdown-divider"></div>
        <form action="/auth/logout" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="dropdown-item" style="color:var(--color-danger);">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            Sign out
          </button>
        </form>
      </div>
    </div>
  </div>
</header>
